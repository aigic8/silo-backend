# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection string. Compose overrides this to use the `db` service.
DATABASE_URL=postgres://silo:silo@localhost:5432/silo
BIND_ADDR=0.0.0.0:3000

# Exact browser Origin accepted for authenticated writes and the websocket.
# The Vite dev server proxies /api (including WS) so the browser is same-origin.
ALLOWED_ORIGIN=http://127.0.0.1:5173

# false for local plain-HTTP development; true behind HTTPS in production.
COOKIE_SECURE=false

# Session lifetime in hours, bounded to 1..=168 (default 168 = one week).
SESSION_TTL_HOURS=168

# docker compose only: host ports. Change these if 5432/3000 are already taken.
APP_PORT=3000
POSTGRES_PORT=5432
